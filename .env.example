# ============================================================================
# Uthena v2 — Environment variables
# Copy to .env.local and fill in. Every secret lives in Doppler/Vault/SSM
# in production; this file is the local-dev contract.
# ============================================================================

# ---- App ----
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Uthena

# ---- Supabase (required) ----
# Get these from `supabase start` output, or from the hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me-anon
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role

# ---- Stripe (PH06 / PH07) ----
# Leave blank locally and checkout will fail closed with a clear error.
# When you add a key, all the call sites in 00-foundations/money/stripe.ts
# light up automatically.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PERSONAL_ACCESS_MONTHLY=price_replace_me_19_usd

# ---- Bunny.net (PH09) ----
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_PUBLIC_HOSTNAME=
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_TOKEN_KEY=
BUNNY_SIGNING_KEY=

# ---- PostHog (PH17) ----
# Empty = analytics off (fail-open). Adding a key enables the seam in
# 00-foundations/analytics/posthog.ts.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ---- Gorse (PH17) ----
# Empty = recommendations off (fail-open). Adding a key enables the
# 00-foundations/recommendations/gorse.ts seam.
GORSE_API_URL=
GORSE_API_KEY=

# ---- Amazon SES (PH18) ----
# Empty = email falls back to console transport in dev.
AWS_REGION=
AWS_SES_FROM_EMAIL=noreply@uthena.com

# ---- OAuth (P1.6) ----
# Display-toggles ONLY. The provider credentials (Google OAuth
# client ID + secret, Apple Services ID + key) live in the
# Supabase project → Authentication → Providers config. These
# env vars just control whether the "Continue with Google" /
# "Continue with Apple" buttons appear on /login + /signup.
#
# Wiring the Supabase side requires:
#   - Google: Google Cloud project + OAuth 2.0 Client ID +
#     Secret, configured in Supabase with redirect URI
#     https://<project>.supabase.co/auth/v1/callback
#   - Apple:  Apple Developer enrollment + Services ID + Key
#     ID + .p8 private key file, configured in Supabase with
#     the same redirect URI + the web domain verification
#     (`.well-known/apple-developer-domain-association`).
#
# See STUB-042 for the full task list. The buttons are code-
# complete and ship the moment these env vars flip to `true` AND
# the Supabase project has the providers configured.
OAUTH_GOOGLE_ENABLED=false
OAUTH_APPLE_ENABLED=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Sentry (PH19) ----
SENTRY_DSN=

# ---- Security ----
# 32+ char random string. Used to sign session cookies. Rotate quarterly
# per 05-ops/runbooks/secret-rotation.md.
AUTH_SECRET=replace-with-32-char-random-string
# Comma-separated list of allowed origins for CORS / Stripe redirects.
ALLOWED_ORIGINS=http://localhost:3000

# ---- Feature flags ----
# Default royalty percentage when a partner has no override. 30% = 3000.
DEFAULT_ROYALTY_PCT_BPS=3000
# PLR discount % for active personal_access subscribers. 15% = 1500.
PLR_SUBSCRIBER_DISCOUNT_PCT_BPS=1500
# Personal access subscription price in cents. $19 = 1900.
PERSONAL_ACCESS_PRICE_CENTS=1900

# ---- RLS test framework (P3.2, live mode) ----
# Set these four to enable `pnpm test:rls:live` against a seeded
# staging Supabase project. The dry-run mode (`pnpm test:rls`)
# works WITHOUT these. See 06-quality/tests/rls/README.md for
# the seed recipe (5-minute Supabase Studio setup) + STUB-045
# for the deferred live-executor work.
SUPABASE_URL_FOR_RLS_TESTS=
SUPABASE_ANON_KEY_FOR_RLS_TESTS=
SUPABASE_SERVICE_ROLE_KEY_FOR_RLS_TESTS=
RLS_SEED_USER_PASSWORD=

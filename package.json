{
  "name": "uthena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Uthena v2 — wholesale PLR video course marketplace",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:rls": "tsx 06-quality/tests/rls/cli.ts",
    "test:rls:live": "tsx 06-quality/tests/rls/cli.ts --live",
    "test:rls:json": "tsx 06-quality/tests/rls/cli.ts --json",
    "check:specs": "bash 04-platform/ci/scripts/check-spec-coverage.sh",
    "check:rls": "bash 04-platform/ci/scripts/check-rls-coverage.sh",
    "check:enum-coverage": "bash 04-platform/ci/scripts/check-enum-coverage.sh",
    "check:no-todo": "bash 04-platform/ci/scripts/check-no-todo.sh",
    "check:pii": "bash 04-platform/ci/scripts/check-pii-logs.sh",
    "check:security-headers": "bash 04-platform/ci/scripts/check-security-headers.sh",
    "check:all": "pnpm typecheck && pnpm lint && pnpm check:specs && pnpm check:rls && pnpm check:enum-coverage && pnpm check:no-todo && pnpm check:pii && pnpm check:security-headers",
    "db:bootstrap": "tsx 04-platform/ci/scripts/db-bootstrap.ts",
    "db:seed": "tsx 04-platform/ci/scripts/db-seed.ts",
    "db:bootstrap:full": "pnpm db:bootstrap:auth && pnpm db:bootstrap && pnpm db:seed",
    "db:bootstrap:auth": "tsx 04-platform/ci/scripts/bootstrap/setup-auth-schema.ts",
    "db:verify": "tsx 04-platform/ci/scripts/db-bootstrap-verify.ts",
    "db:types": "tsx 04-platform/ci/scripts/db-types.ts",
    "db:types:check": "tsx 04-platform/ci/scripts/check-types-fresh.ts",
    "cron:expire-carts": "tsx 04-platform/ci/scripts/cron/expire-carts.ts",
    "cron:detect-abandoned-carts": "tsx 04-platform/ci/scripts/cron/detect-abandoned-carts.ts",
    "cron:release-locked-balances": "tsx 04-platform/ci/scripts/cron/release-locked-balances.ts",
    "cron:email-queue": "tsx 04-platform/ci/scripts/cron/cron-email-queue.ts",
    "cron:partition-rollforward": "tsx 04-platform/ci/scripts/cron/cron-partition-rollforward.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1077.0",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "@tiptap/extension-link": "^2.8.0",
    "@tiptap/pm": "^2.8.0",
    "@tiptap/react": "^2.8.0",
    "@tiptap/starter-kit": "^2.8.0",
    "fflate": "^0.4.8",
    "hls.js": "^1.5.17",
    "next": "15.0.3",
    "pino": "^9.5.0",
    "posthog-js": "^1.181.0",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "react-hook-form": "^7.53.1",
    "stripe": "^17.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "eslint": "^9.14.0",
    "eslint-config-next": "15.0.3",
    "pg": "^8.22.0",
    "prettier": "^3.3.3",
    "supabase": "^1.215.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
